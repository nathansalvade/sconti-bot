# Copia questo file in .env e riempi i valori.

# Token che ti dà @BotFather su Telegram.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chi può usare il bot. Il tuo chat id te lo dice @userinfobot, oppure `python main.py chatid`.
# Il bot risponde SOLO a questi id: è la sua unica protezione.
#
# Per più persone, separa con la virgola. Ricevono tutti gli avvisi e condividono
# la stessa lista di prodotti (chiunque può aggiungere e rimuovere).
#   TELEGRAM_CHAT_ID=123456789,987654321
#
# Importante: ogni persona deve prima aprire la chat col bot e premere Start,
# altrimenti Telegram rifiuta i messaggi ("chat not found") — un bot non può
# scrivere per primo a chi non gli ha mai parlato.
TELEGRAM_CHAT_ID=123456789

# Ogni quante ore ricontrollare i prezzi.
CHECK_INTERVAL_HOURS=6

# Soglia minima di calo per far scattare la notifica, in percentuale rispetto
# all'ultimo prezzo (non un valore assoluto). Default 1.0.
# 0 = avvisa su qualsiasi calo reale (un prezzo invariato o in aumento non conta
# comunque). Valori negativi o non numerici non hanno senso e ricadono sul default.
MIN_DROP_PERCENT=1.0

# Ogni quanti minuti controllare se è ora di mandare il riepilogo prezzi
# periodico a chi lo ha attivato con /notifiche (vedi README).
RIEPILOGO_CHECK_MINUTES=30
